# Application
APP_NAME=Outcome Orchestration Platform
APP_ENV=prototype
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Database — local SQLite for prototype (or Supabase Session pooler URI)
DATABASE_URL=sqlite:///./orchestration.db
SCHEMA_AUTO_CREATE=true
AUTO_SEED=true

ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123

# AI (Gemini — not Google Cloud hosting / Gmail)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Email channel: CloudMailin only (prototype default) ----
EMAIL_PROVIDER=cloudmailin

# Inbound address from CloudMailin dashboard
CLOUDMAILIN_ADDRESS=
# Shared secret for webhook (?secret= or X-Webhook-Secret). Required if APP_ENV=production
CLOUDMAILIN_WEBHOOK_SECRET=
# From address for SMTP replies (verified sender / CloudMailin outbound domain)
CLOUDMAILIN_FROM_EMAIL=
# Outbound SMTP (CloudMailin SMTP Accounts page) — enables live clarification replies
# Example: smtp://USERNAME:PASSWORD@HOST:587
CLOUDMAILIN_SMTP_URL=
# Or discrete fields instead of URL:
# CLOUDMAILIN_SMTP_HOST=
# CLOUDMAILIN_SMTP_PORT=587
# CLOUDMAILIN_SMTP_USERNAME=
# CLOUDMAILIN_SMTP_PASSWORD=

# Optional legacy providers (not used when EMAIL_PROVIDER=cloudmailin)
# EMAIL_PROVIDER=outlook | gmail

PYTHON_VERSION=3.12.8
