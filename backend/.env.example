# Application
APP_NAME=Outcome Orchestration Platform
APP_ENV=prototype
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Database — local SQLite for prototype (or Supabase Session pooler URI)
DATABASE_URL=sqlite:///./orchestration.db
SCHEMA_AUTO_CREATE=true
AUTO_SEED=true

ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123

# AI (Gemini — not Google Cloud hosting)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Inbound: CloudMailin webhook ----
EMAIL_PROVIDER=cloudmailin
CLOUDMAILIN_ADDRESS=
CLOUDMAILIN_WEBHOOK_SECRET=

# ---- Outbound: Gmail SMTP App Password (delivers to real inboxes) ----
# Google Account → Security → 2-Step Verification → App passwords
OUTBOUND_SMTP_HOST=smtp.gmail.com
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USERNAME=yourtestemail@gmail.com
OUTBOUND_SMTP_PASSWORD=
OUTBOUND_SMTP_FROM=yourtestemail@gmail.com

# Optional legacy CloudMailin outbound (often test_mode — may not reach Gmail)
# CLOUDMAILIN_SMTP_URL=smtp://USER:PASS@smtp.cloudmta.net:587

PYTHON_VERSION=3.12.8
