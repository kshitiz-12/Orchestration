# Application
APP_NAME=Outcome Orchestration Platform
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.onrender.com

# ---- Supabase Postgres (Session pooler) ----
# postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Connection pool (API process)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Schema management
# Prototype default: auto-create tables on boot.
# Scalable path: SCHEMA_AUTO_CREATE=false + RUN_MIGRATIONS_ON_STARTUP=true
SCHEMA_AUTO_CREATE=true
RUN_MIGRATIONS_ON_STARTUP=false
AUTO_SEED=true

ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROMPT_VERSION=v1.0.0

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://YOUR-API.onrender.com/api/v1/integrations/gmail/callback
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENT_AI_JOBS=5
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_SECONDS=5

ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWLIST=pdf,png,jpg,jpeg,gif,txt,csv,xlsx,docx
STORAGE_PATH=./storage
AUDIT_APPEND_ONLY=true
PYTHON_VERSION=3.12.8
