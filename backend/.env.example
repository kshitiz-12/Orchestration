# Application
PYTHON_VERSION=3.12.8
APP_NAME=Outcome Orchestration Platform
APP_ENV=prototype
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123
# Ops visibility mailbox — every case FYI + ACTION when a human verdict is needed
ADMIN_OPS_EMAIL=
# Extra ops mailboxes (comma-separated) copied on OPS DECISION and allowed to reply
ADMIN_BACKUP_EMAILS=
# Approval routing — empty falls back to ADMIN_OPS_EMAIL
APPROVAL_MANAGER_EMAIL=
APPROVAL_FINANCE_EMAIL=
# strict | off — admin replies must pass SPF or thread onto our ops mail
ADMIN_SENDER_VERIFICATION=strict
# Proposed-room hold: release after N hours, remind requester after M hours
PROPOSAL_HOLD_HOURS=24
PROPOSAL_REMINDER_HOURS=12
# Background sweep in the web process (seconds, 0 = off)
INPROCESS_SWEEPER_SECONDS=300
# Catering spend (INR ex-tax) at or below this needs no approval; 0 = always ask
CATERING_AUTO_APPROVE_LIMIT=0
# Fallback per-person rate when no catering contract is on file (0 = ops quotes manually)
CATERING_DEFAULT_RATE=0
# Preferred catering vendor (blank = first active catering contract)
CATERING_VENDOR_NAME=
# Off-site venues bookable for large groups: "Name:capacity; Name:capacity"
OFFSITE_VENUES=
# Database — local SQLite, or Supabase Session pooler URI
DATABASE_URL=sqlite:///./orchestration.db
SCHEMA_AUTO_CREATE=true
AUTO_SEED=true

# AI — prefer lite models on free tier (3.6/3.7/3.8 often overload)
GEMINI_API_KEY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Email — CloudMailin only
EMAIL_PROVIDER=cloudmailin
# Inbound webhook address
CLOUDMAILIN_ADDRESS=
CLOUDMAILIN_WEBHOOK_SECRET=
# Outbound from verified domain (HTTPS API works on Render)
CLOUDMAILIN_FROM_EMAIL=orchestration@adminservices.in
CLOUDMAILIN_SMTP_URL=smtp://USER:PASS@smtp.cloudmta.net:587?starttls=true
