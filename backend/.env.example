# Application
PYTHON_VERSION=3.12.8
APP_NAME=Outcome Orchestration Platform
APP_ENV=prototype
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123

# Database — local SQLite, or Supabase Session pooler URI
DATABASE_URL=sqlite:///./orchestration.db
SCHEMA_AUTO_CREATE=true
AUTO_SEED=true

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Email — CloudMailin only
EMAIL_PROVIDER=cloudmailin
# Inbound webhook address
CLOUDMAILIN_ADDRESS=
CLOUDMAILIN_WEBHOOK_SECRET=
# Outbound from verified domain (HTTPS API works on Render)
CLOUDMAILIN_FROM_EMAIL=orchestration@adminservices.in
CLOUDMAILIN_SMTP_URL=smtp://USER:PASS@smtp.cloudmta.net:587?starttls=true
