# Application
APP_NAME=Outcome Orchestration Platform
APP_ENV=production
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
API_PREFIX=/api/v1
# Comma-separated. Include your frontend URL(s).
CORS_ORIGINS=http://localhost:3000,https://YOUR-FRONTEND.onrender.com

# ---- Supabase Postgres ----
# Supabase → Project Settings → Database → Connection string → URI
# Prefer "Session" pooler (port 5432) or Direct connection for FastAPI.
# Avoid Transaction pooler (6543) unless you know you need it.
#
# Example (direct):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Example (session pooler):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# If the password has special characters, URL-encode them.
# sslmode=require is added automatically for *.supabase.co hosts.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Seed demo tenant/admin on first boot (safe / idempotent)
AUTO_SEED=true

# Admin auth (prototype)
ADMIN_EMAIL=admin@prototype.local
ADMIN_PASSWORD=admin123
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Gemini / Google GenAI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_PROMPT_VERSION=v1.0.0

# Gmail OAuth (optional for prototype; API ingest still works)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://YOUR-API.onrender.com/api/v1/integrations/gmail/callback
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_POLL_INTERVAL_SECONDS=30
GMAIL_USER_ID=me

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_CONCURRENT_AI_JOBS=5
WORKER_MAX_RETRIES=5
WORKER_RETRY_BASE_SECONDS=5

# Attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWLIST=pdf,png,jpg,jpeg,gif,txt,csv,xlsx,docx

# Storage (ephemeral on free Render — use Supabase Storage later if needed)
STORAGE_PATH=./storage
AUDIT_APPEND_ONLY=true
